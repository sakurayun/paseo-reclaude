{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "production": {
      "channel": "production",
      "node": "22.14.0",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      },
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "resourceClass": "large",
        "gradleCommand": ":app:bundleRelease -x lint -x lintVitalAnalyzeRelease -x lintVitalRelease -x generateReleaseLintModel -x generateReleaseLintVitalModel"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "production",
        "PASEO_APK_LOW_MEM": "1",
        "PASEO_EAS_APK_LOW_MEM": "1"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -x lint -x lintVitalAnalyzeRelease -x lintVitalRelease -x generateReleaseLintModel -x generateReleaseLintVitalModel --no-daemon --max-workers=1 -Dorg.gradle.parallel=false -Dorg.gradle.workers.max=1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6758887924"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
